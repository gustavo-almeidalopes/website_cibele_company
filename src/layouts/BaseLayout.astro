---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import CartDrawer from '../components/CartDrawer.astro';
import SearchOverlay from '../components/SearchOverlay.astro';

interface Props {
  title?: string;
  description?: string;
  active?: string;
  /** Páginas de vitrine ocupam a largura total, sem respiro extra */
  bleed?: boolean;
}

const {
  title = 'Cibele Plastic — Embalagens em bioplástico',
  description =
    'Loja da Cibele Plastic: embalagens em bioplástico para food service, eventos, cafeterias e delivery. Compostáveis em 180 dias, com o desempenho do plástico convencional.',
  active = '',
  bleed = false,
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f6f2" />
    <link rel="icon" type="image/png" href="/img/faviconum.png" />
    <title>{title}</title>

    <!-- Cormorant Garamond (títulos) + Inter (interface), hospedadas aqui:
         nenhum pedido sai para terceiros e não há salto de layout.
         Só o subset latino entra no caminho crítico. -->
    <link rel="preload" href="/fonts/cormorant-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Cibele Plastic" />

    <script is:inline>
      (function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduce) document.documentElement.classList.add('is-animate');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <Header active={active} />

    <main id="conteudo" class:list={[{ 'main--bleed': bleed }]}>
      <slot />
    </main>

    <Footer />
    <CartDrawer />
    <SearchOverlay />
    <CookieConsent />

    <script>
      import '../scripts/animations.ts';
      import '../scripts/shop-ui.ts';
    </script>
  </body>
</html>
