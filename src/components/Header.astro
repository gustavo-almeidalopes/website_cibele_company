---
import { collections } from '../data/catalog';

interface Props {
  active?: string;
}
const { active = '' } = Astro.props;

const isShopActive = ['embalagens', 'colecoes', 'produto'].includes(active);

const avisos = [
  'Frete grátis acima de R$ 500',
  'Compostável em 180 dias',
  'Amostras para novos clientes',
  'Entrega em todo o Brasil',
];
---

<!-- Faixa de avisos — o "ticker" que a loja usa para prometer pouco e cumprir -->
<div class="ticker" aria-label="Avisos da loja">
  <div class="ticker__track">
    {
      [0, 1].map(() => (
        <div class="ticker__group" aria-hidden="false">
          {avisos.map((aviso) => (
            <span>{aviso}</span>
          ))}
        </div>
      ))
    }
  </div>
</div>

<header class="header" data-header>
  <div class="header__inner container-wide">
    <button
      class="burger"
      type="button"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="menu-mobile"
      aria-label="Abrir menu"
    >
      <span></span>
      <span></span>
    </button>

    <a class="brand" href="/" aria-label="Cibele Plastic — página inicial">
      <span class="brand__text">Cibele</span>
      <span class="brand__sub">Plastic</span>
    </a>

    <nav class="nav" aria-label="Navegação principal">
      <a class:list={['nav__link', { 'is-active': active === 'novidades' }]} href="/embalagens?filtro=novidades">
        Novidades
      </a>

      <div class="nav__item" data-mega-wrap>
        <button
          class:list={['nav__link', 'nav__trigger', { 'is-active': isShopActive }]}
          type="button"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="mega-produtos"
          data-mega-toggle
        >
          Coleções
        </button>

        <div class="mega" id="mega-produtos" data-mega-panel hidden>
          <div class="mega__inner container-wide">
            <div class="mega__cols">
              <div class="mega__col">
                <p class="mega__label ui-sm">Comprar por coleção</p>
                <ul class="mega__list">
                  {
                    collections.map((col) => (
                      <li>
                        <a href={col.path} data-mega-link>
                          {col.titulo}
                        </a>
                      </li>
                    ))
                  }
                  <li>
                    <a href="/embalagens" data-mega-link>Ver tudo</a>
                  </li>
                </ul>
              </div>

              <div class="mega__col">
                <p class="mega__label ui-sm">Seleções</p>
                <ul class="mega__list">
                  <li><a href="/embalagens?filtro=novidades" data-mega-link>Novidades</a></li>
                  <li><a href="/embalagens?filtro=mais-vendidos" data-mega-link>Mais vendidos</a></li>
                  <li><a href="/embalagens?ordem=preco-asc" data-mega-link>Menor preço</a></li>
                  <li><a href="/favoritos" data-mega-link>Meus favoritos</a></li>
                </ul>
              </div>

              <div class="mega__col">
                <p class="mega__label ui-sm">Atendimento</p>
                <ul class="mega__list">
                  <li><a href="/ajuda" data-mega-link>Envios e prazos</a></li>
                  <li><a href="/ajuda#trocas" data-mega-link>Trocas e devoluções</a></li>
                  <li><a href="/contato" data-mega-link>Orçamento para empresas</a></li>
                  <li><a href="/sobre" data-mega-link>Sobre a Cibele</a></li>
                </ul>
              </div>

              <div class="mega__feature">
                {
                  collections.map((col) => (
                    <a class="mega__card" href={col.path} data-mega-link>
                      <span class="mega__card-media">
                        <img src={col.capa} alt="" loading="lazy" decoding="async" width="320" height="400" />
                      </span>
                      <span class="mega__card-title">{col.titulo}</span>
                      <span class="mega__card-cue">{col.destaque}</span>
                    </a>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>

      <a class:list={['nav__link', { 'is-active': active === 'sobre' }]} href="/sobre">Sobre</a>
      <a class:list={['nav__link', { 'is-active': active === 'ajuda' }]} href="/ajuda">Ajuda</a>
    </nav>

    <div class="header__actions">
      <button class="icon-btn" type="button" data-search-open aria-label="Buscar produtos">
        <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.4"></circle>
          <path d="m16 16 4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
        </svg>
      </button>

      <a class="icon-btn header__hide-sm" href="/conta" aria-label="Minha conta">
        <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true">
          <circle cx="12" cy="8.5" r="3.6" fill="none" stroke="currentColor" stroke-width="1.4"></circle>
          <path d="M4.8 20a7.2 7.2 0 0 1 14.4 0" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
        </svg>
      </a>

      <a class="icon-btn icon-btn--count header__hide-sm" href="/favoritos" aria-label="Meus favoritos">
        <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true">
          <path
            d="M12 20.5 4.3 13a4.6 4.6 0 0 1 6.5-6.5l1.2 1.2 1.2-1.2A4.6 4.6 0 0 1 19.7 13Z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linejoin="round"></path>
        </svg>
        <span class="count" data-wish-count hidden>0</span>
      </a>

      <button class="icon-btn icon-btn--count" type="button" data-cart-open aria-label="Abrir cesta de compras">
        <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true">
          <path
            d="M5.5 7.5h13l-1.1 12a1.6 1.6 0 0 1-1.6 1.5H8.2a1.6 1.6 0 0 1-1.6-1.5Z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linejoin="round"></path>
          <path d="M9 9.5V7a3 3 0 0 1 6 0v2.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
        </svg>
        <span class="count" data-cart-count hidden>0</span>
      </button>
    </div>
  </div>
</header>

<!-- Menu mobile em tela cheia -->
<div class="menu" id="menu-mobile" data-menu hidden>
  <div class="menu__scroll">
    <nav class="menu__nav" aria-label="Navegação mobile">
      <a class="menu__link" href="/embalagens?filtro=novidades" data-menu-link>Novidades</a>
      {
        collections.map((col) => (
          <a class="menu__link" href={col.path} data-menu-link>
            {col.titulo}
          </a>
        ))
      }
      <a class:list={['menu__link', { 'is-active': active === 'embalagens' }]} href="/embalagens" data-menu-link>
        Ver tudo
      </a>
    </nav>

    <nav class="menu__sec" aria-label="Conta e atendimento">
      <a href="/conta" data-menu-link>Minha conta</a>
      <a href="/favoritos" data-menu-link>Favoritos</a>
      <a href="/carrinho" data-menu-link>Cesta</a>
      <a href="/ajuda" data-menu-link>Ajuda</a>
      <a href="/sobre" data-menu-link>Sobre</a>
      <a href="/contato" data-menu-link>Contato</a>
    </nav>

    <div class="menu__foot" data-menu-link>
      <p class="ui-sm text-muted">Cibele Plastic</p>
      <p class="text-muted menu__foot-text">
        Embalagens em bioplástico que voltam à terra em 180 dias.
      </p>
    </div>
  </div>
</div>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--header-h);
    display: flex;
    align-items: center;
    /* Fundo sólido por padrão: `backdrop-filter` num elemento fixo custa
       caro no celular e engasga a rolagem. O vidro fica só no desktop. */
    background: var(--cream);
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration) var(--ease), background-color var(--duration) var(--ease);
  }

  @media (min-width: 1040px) {
    .header {
      background: color-mix(in srgb, var(--cream) 86%, transparent);
      backdrop-filter: blur(16px);
    }
  }

  .header.is-scrolled {
    border-bottom-color: var(--line);
  }

  /* Sem `width: 100%` aqui: a largura e as margens vêm do .container-wide —
     senão a marca encosta na borda da tela. As três colunas podem encolher
     (`minmax(0, …)`), o que evita estouro horizontal em telas de 320 px. */
  .header__inner {
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(0, 1fr) minmax(0, auto);
    align-items: center;
    gap: clamp(0.25rem, 2vw, 1rem);
  }

  /* Lockup vertical: a serifa espaçada em cima, a linha de apoio embaixo.
     Empilhado, o conjunto é estreito o bastante para caber em 320 px. */
  .brand {
    display: inline-grid;
    justify-items: center;
    gap: 0.15rem;
    color: var(--bone);
    min-width: 0;
  }

  .brand__text {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 4.5vw, 1.5rem);
    font-weight: 400;
    letter-spacing: 0.2em;
    text-indent: 0.2em; /* compensa o rastro da última letra */
    line-height: 1;
    text-transform: uppercase;
  }

  .brand__sub {
    font-family: var(--font);
    font-size: 0.5rem;
    font-weight: 500;
    letter-spacing: 0.42em;
    text-indent: 0.42em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* Navegação central */
  .nav {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
  }

  .nav__item {
    position: static;
  }

  .nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.6rem 0.95rem;
    font-family: inherit;
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: var(--track);
    text-transform: uppercase;
    color: var(--bone);
    border: 0;
    background: transparent;
    transition: color var(--duration) var(--ease);
  }

  .nav__link::after {
    content: '';
    position: absolute;
    left: 0.95rem;
    right: 0.95rem;
    bottom: 1.05rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration) var(--ease);
  }

  .nav__link:hover::after,
  .nav__trigger.is-open::after,
  .nav__link.is-active::after {
    transform: scaleX(1);
  }

  /* Mega menu */
  .mega {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 90;
    background: var(--cream);
    border-block: 1px solid var(--line);
    box-shadow: var(--shadow-md);
  }

  .mega[hidden] {
    display: none;
  }

  .mega__inner {
    padding-block: clamp(2rem, 3.5vw, 3.25rem);
  }

  .mega__cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 0.75fr)) minmax(0, 2fr);
    gap: 2.5rem;
  }

  .mega__label {
    color: var(--muted);
    margin-bottom: 1.1rem;
  }

  .mega__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .mega__list a {
    font-size: var(--step--1);
    color: var(--bone);
    transition: color var(--duration) var(--ease);
  }

  .mega__list a:hover {
    color: var(--accent-ink);
  }

  .mega__feature {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .mega__card {
    display: grid;
    gap: 0.5rem;
  }

  .mega__card-media {
    display: block;
    aspect-ratio: 4 / 5;
    background: var(--ink-2);
    overflow: hidden;
  }

  .mega__card-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 14%;
    mix-blend-mode: multiply;
    transition: transform var(--duration-slow) var(--ease);
  }

  .mega__card:hover .mega__card-media img {
    transform: scale(1.05);
  }

  .mega__card-title {
    font-size: var(--step--1);
    font-weight: 500;
  }

  .mega__card-cue {
    font-size: 0.6875rem;
    letter-spacing: var(--track);
    text-transform: uppercase;
    color: var(--muted);
  }

  /* Ações à direita */
  .header__actions {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 0.1rem;
  }

  .icon-btn--count {
    position: relative;
  }

  .count {
    position: absolute;
    top: 6px;
    right: 4px;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: var(--forest);
    color: var(--cream);
    font-size: 0.5625rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .count[hidden] {
    display: none;
  }

  /* Burger */
  .burger {
    position: relative;
    width: 44px;
    height: 44px;
    margin-left: -10px;
    border: 0;
    background: transparent;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 5px;
  }

  .burger span {
    display: block;
    width: 20px;
    height: 1.2px;
    background: var(--bone);
    transition: transform var(--duration) var(--ease);
  }

  :global(body.menu-open) .burger span:first-child {
    transform: translateY(3.1px) rotate(45deg);
  }

  :global(body.menu-open) .burger span:last-child {
    transform: translateY(-3.1px) rotate(-45deg);
  }

  :global(html.menu-open),
  :global(body.menu-open) {
    overflow: hidden;
  }

  /* Menu mobile */
  .menu {
    position: fixed;
    inset: var(--header-h) 0 0;
    z-index: 95;
    background: var(--cream);
    overflow-y: auto;
  }

  .menu[hidden] {
    display: none;
  }

  .menu__scroll {
    padding: 2rem var(--gutter) 3rem;
    display: grid;
    gap: 2.5rem;
  }

  .menu__nav {
    display: grid;
  }

  .menu__link {
    display: flex;
    align-items: center;
    min-height: 56px;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--bone);
    transition: padding-left var(--duration) var(--ease);
  }

  .menu__link:hover,
  .menu__link.is-active {
    padding-left: 0.5rem;
  }

  .menu__sec {
    display: grid;
    gap: 1rem;
  }

  .menu__sec a {
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: var(--track);
    text-transform: uppercase;
    color: var(--muted);
  }

  .menu__sec a:hover {
    color: var(--bone);
  }

  .menu__foot-text {
    margin-top: 0.5rem;
    max-width: 30ch;
    font-size: var(--step--1);
  }

  @media (min-width: 1040px) {
    .nav {
      display: flex;
    }
    .burger {
      display: none;
    }
    .menu {
      display: none !important;
    }
    .header__inner {
      grid-template-columns: 220px 1fr 220px;
    }
  }

  @media (max-width: 1039.98px) {
    .mega {
      display: none !important;
    }
    .header__hide-sm {
      display: none;
    }
  }
</style>
