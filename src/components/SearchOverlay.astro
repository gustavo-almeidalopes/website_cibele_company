---
import { searchIndex, collections } from '../data/catalog';

const indice = searchIndex();
const sugestoes = ['Marmita', 'Copo', 'Talheres', 'Sacola', 'Canudo', 'Guardanapo'];
---

<div class="search" data-search hidden aria-label="Busca" role="dialog" aria-modal="true">
  <div class="search__bar">
    <div class="container-wide search__bar-inner">
      <form class="search__form" role="search" action="/busca" method="get">
        <svg class="search__icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.4"></circle>
          <path d="m16 16 4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
        </svg>
        <input
          class="search__input"
          type="search"
          name="q"
          placeholder="O que você procura?"
          autocomplete="off"
          aria-label="Buscar produtos"
          data-search-input
        />
      </form>
      <button class="icon-btn" type="button" data-search-close aria-label="Fechar busca">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="search__panel">
    <div class="container-wide search__panel-inner">
      <div class="search__aside">
        <p class="ui-sm text-muted">Sugestões</p>
        <ul class="search__chips">
          {
            sugestoes.map((termo) => (
              <li>
                <button type="button" data-search-suggest={termo}>
                  {termo}
                </button>
              </li>
            ))
          }
        </ul>

        <p class="ui-sm text-muted search__aside-label">Coleções</p>
        <ul class="search__links">
          {
            collections.map((col) => (
              <li>
                <a href={col.path}>{col.titulo}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="search__results">
        <p class="ui-sm text-muted" data-search-status>Comece a digitar para ver resultados</p>
        <div class="search__grid" data-search-results></div>
      </div>
    </div>
  </div>
</div>

<script type="application/json" id="search-index" set:html={JSON.stringify(indice)}></script>

<style>
  .search {
    position: fixed;
    inset: 0;
    z-index: 160;
    background: var(--cream);
    display: flex;
    flex-direction: column;
    opacity: 0;
    transition: opacity var(--duration) var(--ease);
  }

  .search.is-open {
    opacity: 1;
  }

  .search[hidden] {
    display: none;
  }

  .search__bar {
    border-bottom: 1px solid var(--line);
  }

  .search__bar-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: var(--header-h);
  }

  .search__form {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .search__icon {
    color: var(--muted);
    flex-shrink: 0;
  }

  .search__input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 3.5vw, 1.75rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--bone);
    padding-block: 1rem;
  }

  .search__input:focus {
    outline: none;
  }

  .search__input::placeholder {
    color: var(--muted-dark);
  }

  .search__input::-webkit-search-cancel-button {
    appearance: none;
  }

  .search__panel {
    flex: 1;
    overflow-y: auto;
    padding-block: clamp(1.5rem, 4vw, 2.75rem) 3rem;
  }

  .search__panel-inner {
    display: grid;
    gap: 2.5rem;
  }

  .search__chips {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .search__chips button {
    padding: 0.5rem 0.95rem;
    border: 1px solid var(--line-strong);
    background: transparent;
    font-size: 0.6875rem;
    letter-spacing: var(--track);
    text-transform: uppercase;
    color: var(--bone);
    transition: background-color var(--duration) var(--ease), color var(--duration) var(--ease),
      border-color var(--duration) var(--ease);
  }

  .search__chips button:hover {
    background: var(--forest);
    border-color: var(--forest);
    color: var(--cream);
  }

  .search__aside-label {
    margin-top: 2rem;
  }

  .search__links {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }

  .search__links a {
    font-size: var(--step--1);
    color: var(--bone);
  }

  .search__links a:hover {
    color: var(--accent-ink);
  }

  .search__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem var(--gutter-col);
    margin-top: 1.2rem;
  }

  .search__grid:empty {
    margin-top: 0;
  }

  /* Resultado — escrito pelo cliente */
  .search :global(.sresult) {
    display: block;
  }

  .search :global(.sresult__media) {
    aspect-ratio: 4 / 5;
    background: var(--ink-2);
    overflow: hidden;
  }

  .search :global(.sresult__media img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 12%;
    mix-blend-mode: multiply;
    transition: transform var(--duration-slow) var(--ease);
  }

  .search :global(.sresult:hover img) {
    transform: scale(1.04);
  }

  .search :global(.sresult__name) {
    margin-top: 0.7rem;
    font-size: var(--step--1);
    font-weight: 500;
  }

  .search :global(.sresult__meta) {
    margin-top: 0.15rem;
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .search :global(.sresult__price) {
    margin-top: 0.3rem;
    font-size: var(--step--1);
    font-weight: 600;
  }

  @media (min-width: 860px) {
    .search__panel-inner {
      grid-template-columns: 240px 1fr;
      gap: 4rem;
    }
    .search__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
