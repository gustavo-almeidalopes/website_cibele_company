---
import {
  formatPrice,
  precoBase,
  precoUnitario,
  badges,
  collectionLabels,
  type Product,
} from '../data/catalog';

interface Props {
  product: Product;
  index?: number;
  /** Carrega a imagem com prioridade (primeiras linhas da vitrine) */
  eager?: boolean;
}

const { product, index = 0, eager = false } = Astro.props;

const href = `/produto/${product.slug}`;
const preco = precoBase(product);
const unitario = precoUnitario(product);
const menorVariante = product.variantes.reduce((a, b) => (a.preco <= b.preco ? a : b));
const esgotado = product.variantes.every((v) => v.estoque === 0);
---

<article class="pcard" data-reveal-item data-product={product.slug}>
  <div class="pcard__frame">
    <a class="pcard__link" href={href} aria-label={`${product.nome} — ver produto`}>
      <div class="pcard__media">
        <img
          class="pcard__img"
          src={product.imagens[0]}
          alt={product.nome}
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
          width="600"
          height="750"
        />
        {
          product.imagens[1] && (
            <img
              class="pcard__img pcard__img--alt"
              src={product.imagens[1]}
              alt=""
              aria-hidden="true"
              loading="lazy"
              decoding="async"
              width="600"
              height="750"
            />
          )
        }

        {product.badge && <span class:list={['badge', `badge--${product.badge}`, 'pcard__badge']}>{badges[product.badge]}</span>}
        {esgotado && <span class="pcard__sold ui-sm">Esgotado</span>}
      </div>
    </a>

    <button
      class="pcard__wish"
      type="button"
      data-wish={product.slug}
      aria-pressed="false"
      aria-label={`Adicionar ${product.nome} aos favoritos`}
    >
      <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
        <path
          d="M12 20.5 4.3 13a4.6 4.6 0 0 1 6.5-6.5l1.2 1.2 1.2-1.2A4.6 4.6 0 0 1 19.7 13Z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linejoin="round"></path>
      </svg>
    </button>

    <button
      class="pcard__add"
      type="button"
      data-add-sku={menorVariante.sku}
      data-add-name={product.nome}
      disabled={esgotado}
    >
      <span>{esgotado ? 'Indisponível' : 'Adicionar'}</span>
    </button>
  </div>

  <div class="pcard__body">
    <div class="pcard__info">
      <h3 class="pcard__name">
        <a href={href}>{product.nome}</a>
      </h3>
      <p class="pcard__meta">{collectionLabels[product.colecao]} · {menorVariante.rotulo}</p>
    </div>
    <div class="pcard__prices">
      <span class="pcard__price">{formatPrice(preco)}</span>
      <span class="pcard__unit">{formatPrice(unitario)} / un.</span>
    </div>
  </div>

  <span class="visually-hidden">Posição {index + 1} na vitrine</span>
</article>

<style>
  .pcard {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  /* O quadro tem exatamente a altura da imagem — é a âncora da
     adição rápida e do botão de favoritos. */
  .pcard__frame {
    position: relative;
  }

  .pcard__link {
    display: block;
  }

  /* Fundo com um gradiente quase imperceptível: dá profundidade ao
     produto sem virar "caixa cinza". */
  .pcard__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: linear-gradient(170deg, var(--ink-2) 0%, color-mix(in srgb, var(--ink-2) 55%, var(--cream)) 100%);
  }

  .pcard__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 7%;
    transition: opacity var(--duration-slow) var(--ease), transform 700ms var(--ease);
    mix-blend-mode: multiply;
  }

  .pcard__img--alt {
    opacity: 0;
  }

  @media (hover: hover) {
    .pcard:hover .pcard__img {
      transform: scale(1.04);
    }

    .pcard:hover .pcard__img--alt {
      opacity: 1;
    }

    .pcard:hover .pcard__img:not(.pcard__img--alt) {
      opacity: 0;
    }
  }

  .pcard__badge {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    z-index: 2;
  }

  .pcard__sold {
    position: absolute;
    left: 0;
    bottom: 0;
    z-index: 2;
    padding: 0.45rem 0.85rem;
    background: var(--cream);
    color: var(--muted);
  }

  .pcard__wish {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 3;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border: 0;
    background: transparent;
    color: var(--bone);
    opacity: 0.55;
    transition: opacity var(--duration) var(--ease), color var(--duration) var(--ease);
  }

  .pcard__wish:hover {
    opacity: 1;
  }

  .pcard__wish[aria-pressed='true'] {
    opacity: 1;
    color: var(--accent-ink);
  }

  .pcard__wish[aria-pressed='true'] path {
    fill: currentColor;
  }

  /* Em telas estreitas o preço desce para baixo do nome — lado a lado, os
     dois se espremem e quebram em três linhas cada. */
  .pcard__body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-top: 0.9rem;
  }

  @media (min-width: 620px) {
    .pcard__body {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
    }
  }

  .pcard__name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.25;
  }

  /* Fio dourado que nasce sob o nome ao passar o mouse */
  .pcard__name a {
    background: linear-gradient(var(--accent-premium), var(--accent-premium)) no-repeat left bottom / 0 1px;
    padding-bottom: 2px;
    transition: background-size var(--duration-slow) var(--ease);
  }

  .pcard:hover .pcard__name a {
    background-size: 100% 1px;
  }

  .pcard__name a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .pcard__meta {
    margin-top: 0.3rem;
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .pcard__prices {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  @media (min-width: 620px) {
    .pcard__prices {
      display: block;
      text-align: right;
    }
  }

  .pcard__price {
    display: block;
    font-size: var(--step--1);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .pcard__unit {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.6875rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  /* Adição rápida — encostada na base da imagem. No toque fica
     sempre visível; no ponteiro fino, surge no hover. */
  .pcard__add {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    min-height: 44px;
    border: 0;
    border-top: 1px solid var(--line);
    /* Sólido: no celular este botão fica sempre visível em todos os
       cartões — um blur por cartão engasga a rolagem. */
    background: var(--cream);
    color: var(--bone);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    transition: background-color var(--duration) var(--ease), color var(--duration) var(--ease),
      opacity var(--duration) var(--ease), transform var(--duration) var(--ease);
  }

  .pcard__add:hover {
    background: var(--forest);
    color: var(--cream);
  }

  .pcard__add[disabled] {
    opacity: 0.5;
    pointer-events: none;
  }

  .pcard__add.is-added {
    background: var(--forest);
    color: var(--cream);
  }

  @media (hover: hover) {
    .pcard__add {
      opacity: 0;
      transform: translateY(100%);
    }

    .pcard:hover .pcard__add,
    .pcard:focus-within .pcard__add {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
